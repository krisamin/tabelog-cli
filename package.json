{
  "name": "@krisamin/tabelog-cli",
  "version": "0.5.0",
  "description": "Tabelog CLI and MCP server: search, filter and read Japanese restaurants without a browser",
  "license": "MIT",
  "author": "krisamin",
  "repository": {
    "type": "git",
    "url": "https://github.com/krisamin/tabelog-cli.git"
  },
  "type": "module",
  "bin": {
    "tabelog": "src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "fixture:refresh": "bun test/fixture-refresh.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
